// 人物倾向变量。只跟踪两项，并以正负数表示程度
VAR forceful = 0
VAR evasive = 0


// 随身物品
VAR teacup = false
VAR gotcomponent = false


// 剧情状态：可使用 knot 阅读次数、汇总复杂逻辑的函数或变量表达
VAR drugged = false
VAR hooper_mentioned = false

VAR losttemper = false
VAR admitblackmail = false

// 我们向胡珀透露了哪一种线索？
CONST NONE = 0
CONST STRAIGHT = 1
CONST CHESS = 2
CONST CROSSWORD = 3
VAR hooperClueType = NONE

VAR hooperConfessed = false

CONST SHOE = 1
CONST BUCKET = 2
VAR smashingWindowItem = NONE

VAR notraitor = false
VAR revealedhooperasculprit = false
VAR smashedglass = false
VAR muddyshoes = false

VAR framedhooper = false

// 你如何处理了那个部件？
VAR putcomponentintent = false
VAR throwncomponentaway = false
VAR piecereturned = false
VAR longgrasshooperframe = false


// DEBUG 模式会添加几个捷径——发布时记得设为 false！
VAR DEBUG = false
{DEBUG:
	调试模式！
	*	[从头开始……]	-> start
	*	[栽赃胡珀……] -> claim_hooper_took_component
	*	[进入胡珀的小屋……] -> inside_hoopers_hut
- else:
	// 第一次跳转：故事从哪里开始？
 -> start
}

 /*--------------------------------------------------------------------------------
	用函数封装人物倾向的变化，便于将来扩展逻辑
--------------------------------------------------------------------------------*/


 === function lower(ref x)
 	~ x = x - 1

 === function raise(ref x)
 	~ x = x + 1

/*--------------------------------------------------------------------------------

	故事开始！

--------------------------------------------------------------------------------*/

